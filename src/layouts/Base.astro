---
// src/layouts/Base.astro
// TODO: Agent 2 (Claude) - Implement full base layout with Navbar, Footer, SEO meta tags, dark mode tokens
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'briancgx | Cybersecurity & CTF Writeups',
  description = 'Personal cybersecurity portfolio and writeups by briancgx (Pentester, HTB CyberGh0st Team).',
  image = '/assets/images/ig.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://briancgx.me');
---
<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />
  </head>
  <body class="bg-neutral-950 text-neutral-100 min-h-screen flex flex-col">
    <!-- TODO: Agent 2 (Claude) - Header / Navbar -->
    <header class="border-b border-neutral-800 px-6 py-4 flex justify-between items-center">
      <div class="font-mono text-emerald-400 font-bold text-lg">
        <a href="/">briancgx.me</a>
      </div>
      <nav class="flex gap-4 text-sm font-medium">
        <a href="/" class="hover:text-emerald-400">Home</a>
        <a href="/writeups/" class="hover:text-emerald-400">Writeups</a>
        <a href="/about/" class="hover:text-emerald-400">About</a>
        <a href="/challenge/" class="hover:text-emerald-400">Challenge</a>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <!-- TODO: Agent 2 (Claude) - Footer -->
    <footer class="border-t border-neutral-800 px-6 py-4 text-center text-xs text-neutral-500">
      <p>&copy; {new Date().getFullYear()} briancgx. All rights reserved.</p>
    </footer>
  </body>
</html>
