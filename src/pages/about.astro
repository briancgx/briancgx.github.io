---
import Base from '@/layouts/Base.astro';
import Whoami from '@/components/about/Whoami.astro';
import Publications from '@/components/about/Publications.astro';
import { IDENTITY } from '@/consts';
---

<Base
  title="About"
  description={`${IDENTITY.handle} — ${IDENTITY.role} y ${IDENTITY.role2} desde ${IDENTITY.location}.`}
>
  <header class="mb-8">
    <p class="mb-2 font-mono text-xs uppercase tracking-widest text-ai">
      <span class="prompt"></span>cat about.md
    </p>
    <h1 class="text-3xl font-bold text-text">About</h1>
    <p class="mt-3 max-w-prose text-text/80">
      {IDENTITY.role} y {IDENTITY.role2} desde {IDENTITY.location}. {IDENTITY.focus}
      Este espacio recoge writeups de máquinas y notas de research en seguridad
      de sistemas de IA agéntica.
    </p>
  </header>

  <div class="max-w-2xl">
    <Whoami />
    <Publications />
  </div>
</Base>
