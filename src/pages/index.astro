---
// src/pages/index.astro
// TODO: Agent 2 (Claude) - Implement Home page (Hero section, Featured Writeups, Whoami preview, Tech stack badges)
import Base from '../layouts/Base.astro';
import Hero from '../components/hero/Hero.astro';
import { getCollection } from 'astro:content';

const writeups = await getCollection('writeups', ({ data }) => !data.draft);
---
<Base title="briancgx - Cybersecurity & CTF Writeups">
  <Hero />
  <section class="max-w-4xl mx-auto px-4 py-8">
    <h2 class="text-2xl font-bold mb-4">Recent Writeups</h2>
    <ul class="space-y-4">
      {writeups.map((w) => (
        <li class="border border-neutral-800 p-4 rounded-lg">
          <a href={`/writeups/${w.slug || w.id.replace(/\.md$/, '')}/`} class="text-xl text-emerald-400 hover:underline font-semibold">
            {w.data.title}
          </a>
          <p class="text-neutral-400 text-sm mt-1">{w.data.excerpt}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
