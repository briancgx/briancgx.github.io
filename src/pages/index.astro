---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/hero/Hero.astro';
import WriteupCard from '@/components/writeup/WriteupCard.astro';
import { getWriteups, writeupHref, writeupImage } from '@/lib/writeups';

const writeups = await getWriteups();
const recent = writeups.slice(0, 6);
---

<Base>
  <Hero />

  <section class="mt-16">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="font-mono text-xl font-semibold text-text">
        <span class="text-ai">#</span> recent writeups
      </h2>
      <a href="/writeups" class="font-mono text-sm text-muted hover:text-ai">
        ver todos →
      </a>
    </div>

    {
      recent.length === 0 ? (
        <p class="font-mono text-sm text-muted">No hay writeups publicados aún.</p>
      ) : (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {recent.map((w) => (
            <WriteupCard
              title={w.data.title}
              href={writeupHref(w)}
              excerpt={w.data.excerpt}
              platform={w.data.platform}
              difficulty={w.data.difficulty}
              lang={w.data.lang}
              tags={w.data.tags}
              date={w.data.date}
              machine_image={writeupImage(w)}
            />
          ))}
        </div>
      )
    }
  </section>
</Base>
