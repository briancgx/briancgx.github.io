---
import Base from '@/layouts/Base.astro';
import ChallengeBox from '@/components/challenge/ChallengeBox.tsx';
---

<Base
  title="Challenge"
  description="Reto de seguridad de IA agéntica: jailbreak de un guardián (prompt injection) y abuso de una tool oculta (tool-use). Dos niveles."
  noindex={true}
>
  <header class="mb-8 max-w-prose">
    <p class="mb-2 font-mono text-xs uppercase tracking-widest text-ops">
      <span class="prompt"></span>./challenge --start
    </p>
    <h1 class="text-3xl font-bold text-text">AI Security Challenge</h1>
    <p class="mt-3 text-text/80">
      Dos agentes, dos objetivos. Pon a prueba tus técnicas de
      <span class="text-ai">prompt injection</span> y
      <span class="text-ai">abuso de tool-use</span> contra defensas reales.
      El backend corre en una VPS aislada; nada de esto toca datos reales.
    </p>
  </header>

  <ChallengeBox client:load />

  <p class="mt-8 max-w-prose font-mono text-xs text-muted">
    <span class="text-ai">#</span> nota: este reto es educativo. Las flags las
    define el operador; el agente solo las revela si logras vulnerar sus defensas.
  </p>
</Base>
