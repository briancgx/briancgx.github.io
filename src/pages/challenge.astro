---
import Base from '@/layouts/Base.astro';
import ChallengeBox from '@/components/challenge/ChallengeBox.tsx';
---

<Base
  title="Challenge"
  description="Reto de seguridad de IA agéntica: jailbreak de un guardián (prompt injection) y abuso de una tool oculta (tool-use). Dos niveles."
  noindex={true}
>
  <header class="mb-8 max-w-prose">
    <p class="mb-2 font-mono text-xs uppercase tracking-widest text-ops">
      <span class="prompt"></span>./challenge --start
    </p>
    <h1 class="text-3xl font-bold text-text">AI Security Challenge</h1>
    <p class="mt-3 text-text/80">
      Diviértete un rato rompiendo IA, que es de lo que más me gusta, y
      cuéntame si lo lograste.
    </p>
  </header>

  <ChallengeBox client:load />
</Base>
