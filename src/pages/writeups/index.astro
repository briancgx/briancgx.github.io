---
import Base from '@/layouts/Base.astro';
import SearchBar from '@/components/search/SearchBar.astro';
import WriteupCatalog from '@/components/catalog/WriteupCatalog.tsx';
import type { CatalogItem } from '@/components/catalog/WriteupCatalog.tsx';
import { getWriteups, writeupHref } from '@/lib/writeups';

const writeups = await getWriteups();
const items: CatalogItem[] = writeups.map((w) => ({
  title: w.data.title,
  href: writeupHref(w),
  excerpt: w.data.excerpt,
  platform: w.data.platform,
  difficulty: w.data.difficulty,
  lang: w.data.lang,
  tags: w.data.tags,
  date: w.data.date.toISOString().slice(0, 10),
  machine_image: w.data.machine_image,
}));
---

<Base
  title="Writeups"
  description="Catálogo de writeups de máquinas y retos — filtra por plataforma, dificultad, tags e idioma."
>
  <header class="mb-8">
    <p class="mb-2 font-mono text-xs uppercase tracking-widest text-ai">
      <span class="prompt"></span>ls -la writeups/
    </p>
    <h1 class="text-3xl font-bold text-text">Writeups</h1>
  </header>

  <div class="mb-8">
    <SearchBar />
  </div>

  <WriteupCatalog client:idle items={items} />
</Base>
