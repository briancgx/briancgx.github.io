---
import { IDENTITY, SOCIAL, CV_PATH, SHOW_CV, SHOW_CERTS, CERTS, HTB_PRO_LABS } from '@/consts';

// HTB link is only rendered once Brian supplies a real URL.
const htbReady = SOCIAL.htb.startsWith('http');
---

<div class="card overflow-hidden font-mono text-sm">
  <div class="flex items-center gap-2 border-b border-border bg-surface2 px-4 py-2 text-xs">
    <span class="text-muted">whoami</span>
    <span class="ml-auto flex items-center gap-1.5">
      <span class="h-1.5 w-1.5 rounded-full bg-ai" aria-hidden="true"></span>
      <span class="text-ai">ACTIVE</span>
    </span>
  </div>

  <dl class="grid grid-cols-[6.5rem_1fr] gap-x-4 gap-y-2 bg-[#0d121b] p-5 leading-6">
    <dt class="text-muted">handle</dt>
    <dd class="text-ai">{IDENTITY.handle}</dd>

    <dt class="text-muted">role</dt>
    <dd class="text-text">{IDENTITY.role}</dd>

    <dt class="text-muted">also</dt>
    <dd class="text-text">{IDENTITY.role2}</dd>

    <dt class="text-muted">team</dt>
    <dd class="text-text">{IDENTITY.team}</dd>

    <dt class="text-muted">location</dt>
    <dd class="text-text">{IDENTITY.location}</dd>

    <dt class="text-muted">contact</dt>
    <dd>
      <a href={`mailto:${IDENTITY.email}`} class="link-ai">{IDENTITY.email}</a>
    </dd>
  </dl>
</div>

<div class="mt-6 grid gap-4 sm:grid-cols-2">
  <div class="card p-5">
    <h3 class="mb-3 font-mono text-xs uppercase tracking-widest text-ops">
      offensive stack
    </h3>
    <ul class="space-y-1.5 text-sm text-text/85">
      {IDENTITY.stack.offensive.map((s) => (
        <li class="flex items-center gap-2">
          <span class="text-ops" aria-hidden="true">▸</span>{s}
        </li>
      ))}
    </ul>
  </div>
  <div class="card p-5">
    <h3 class="mb-3 font-mono text-xs uppercase tracking-widest text-ai">
      ai security stack
    </h3>
    <ul class="space-y-1.5 text-sm text-text/85">
      {IDENTITY.stack.ai.map((s) => (
        <li class="flex items-center gap-2">
          <span class="text-ai" aria-hidden="true">▸</span>{s}
        </li>
      ))}
    </ul>
  </div>
</div>

<div class="mt-6 flex flex-wrap gap-3 font-mono text-sm">
  {
    SHOW_CV ? (
      <a
        href={CV_PATH}
        download
        class="rounded border border-ai/40 bg-ai/10 px-4 py-2 text-ai transition-colors hover:bg-ai/20"
      >
        ↓ descargar CV
      </a>
    ) : (
      <span
        class="cursor-not-allowed rounded border border-dashed border-border px-4 py-2 text-muted/60"
        title="TODO: Brian colocará el CV real en public/cv/"
      >
        CV (pronto)
      </span>
    )
  }
  {
    htbReady ? (
      <a
        href={SOCIAL.htb}
        rel="noopener noreferrer"
        target="_blank"
        class="rounded border border-border px-4 py-2 text-muted transition-colors hover:border-ai/40 hover:text-text"
      >
        HackTheBox ↗
      </a>
    ) : (
      <span
        class="cursor-not-allowed rounded border border-dashed border-border px-4 py-2 text-muted/60"
        title="TODO: Brian proporcionará la URL del perfil de HackTheBox"
      >
        HackTheBox (pronto)
      </span>
    )
  }
</div>

{
  /* Certifications: badges oficiales de cada emisor. Confirmadas desde el CV. */
}
{
  SHOW_CERTS && CERTS.length > 0 && (
    <div class="mt-8">
      <h3 class="mb-3 font-mono text-xs uppercase tracking-widest text-muted">
        <span class="text-ai">#</span> certifications
      </h3>
      <ul class="grid gap-3 sm:grid-cols-2">
        {CERTS.map((c) => (
          <li class="card flex items-center gap-4 p-4">
            <img
              src={c.badge}
              alt={`${c.code} badge`}
              width="56"
              height="56"
              loading="lazy"
              decoding="async"
              class="h-14 w-14 shrink-0 object-contain"
            />
            <div class="min-w-0">
              <p class="font-mono text-xs font-semibold text-ai">{c.code}</p>
              <p class="truncate text-sm text-text" title={c.name}>{c.name}</p>
              <p class="font-mono text-xs text-muted">
                {c.issuer} · {c.year}
              </p>
            </div>
          </li>
        ))}
      </ul>

      {HTB_PRO_LABS.length > 0 && (
        <div class="mt-4 flex flex-wrap items-center gap-2 font-mono text-xs">
          <span class="text-muted">HTB Pro Labs · Red Team Operator L1:</span>
          {HTB_PRO_LABS.map((lab) => (
            <span class="rounded border border-ops/40 px-2 py-0.5 text-ops">
              {lab}
            </span>
          ))}
        </div>
      )}
    </div>
  )
}
