---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
// Only h2/h3 make a useful contents tree.
const headings = Astro.props.headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  headings.length > 0 && (
    <nav class="toc" aria-label="Tabla de contenidos">
      <p class="mb-3 font-mono text-xs uppercase tracking-widest text-muted">
        <span class="text-ai">$</span> cat toc
      </p>
      <ul class="space-y-1 border-l border-border font-mono text-sm">
        {headings.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              data-toc-link={h.slug}
              class:list={[
                '-ml-px block border-l-2 border-transparent py-1 text-muted transition-colors hover:text-text',
                h.depth === 3 ? 'pl-6' : 'pl-3',
              ]}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'),
  );
  if (links.length) {
    const bySlug = new Map(links.map((l) => [l.dataset.tocLink!, l]));
    const activate = (slug: string) => {
      for (const l of links) {
        const on = l.dataset.tocLink === slug;
        l.classList.toggle('border-ai', on);
        l.classList.toggle('text-ai', on);
        l.classList.toggle('text-muted', !on);
      }
    };

    const headings = links
      .map((l) => document.getElementById(l.dataset.tocLink!))
      .filter((el): el is HTMLElement => !!el);

    const observer = new IntersectionObserver(
      (entries) => {
        // Pick the topmost heading currently intersecting the viewport band.
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]?.target.id) activate(visible[0].target.id);
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 },
    );
    headings.forEach((h) => observer.observe(h));

    // Reflect in-page clicks immediately.
    links.forEach((l) =>
      l.addEventListener('click', () => activate(l.dataset.tocLink!)),
    );
  }
</script>
