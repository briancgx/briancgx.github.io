# --- briancgx.me agent backend ---

# DeepSeek API key (server-side ONLY — never ships to the browser bundle).
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Cheap chat model.
MODEL=deepseek-chat

# Low cap keeps cost/abuse down (tokens per reply).
MAX_TOKENS=350

# Rate limit: max requests per IP per window (window = 60s).
RATE_LIMIT=20
# Max concurrent upstream calls per IP (holds the 25s timeout).
MAX_INFLIGHT_PER_IP=2

# Comma-separated allowed origins for CORS.
ALLOWED_ORIGINS=https://briancgx.me

# Port the server listens on (Caddy proxies to this).
PORT=8080

# --- Challenge flags ---
# TODO(brian): set real, personal/funny flags. These placeholders are safe to
# ship but should be replaced before the challenge goes live.
FLAG_L1=FLAG{L1_TODO_brian_pon_una_flag_chistosa}
FLAG_L2=FLAG{L2_TODO_brian_pon_otra_flag_chistosa}
